---
/**
 * The header every page wears: the site name, the main navigation, and the
 * language switcher.
 *
 * It takes no list of links. The navigation comes from the architecture
 * declared in `src/lib/navigation.ts`, filtered to the routes the build
 * actually emitted, so a page a later ticket adds appears here on its own and
 * a page that does not exist is never linked. Later tickets use this component
 * unchanged.
 *
 * There is no menu button, because a menu button needs JavaScript and this
 * site promises almost none: on a narrow screen the links wrap instead. That
 * also keeps every navigation item in the tab order with no state to get into.
 */
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Locale } from '../lib/i18n';
import { href } from '../lib/i18n';
import { chromeText, primaryNav } from '../lib/navigation';

interface Props {
  /** The language this page is written in. */
  locale: Locale;
  /** The name shown as the home link. */
  siteName: string;
  /**
   * The same page in the other language, or `undefined` when none was built.
   * The switcher renders if and only if this is defined.
   */
  counterpart: string | undefined;
}

const { locale, siteName, counterpart } = Astro.props;

const links = primaryNav(locale);
const { primaryNavLabel } = chromeText[locale];
---

<header class="border-b border-border">
  <div
    class="mx-auto flex max-w-(--text-measure) flex-wrap items-center gap-x-6 gap-y-2 px-4 py-4"
  >
    <a href={href(locale)} class="font-semibold text-fg no-underline">{siteName}</a>

    {
      links.length > 0 && (
        <nav aria-label={primaryNavLabel} class="grow">
          <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-muted underline-offset-4 hover:text-fg">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <LanguageSwitcher locale={locale} counterpart={counterpart} />
  </div>
</header>
