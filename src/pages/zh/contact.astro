---
/**
 * The Traditional Chinese contact page.
 *
 * Its prose is not written here. Every paragraph comes from
 * `src/data/zh-copy.yaml` through `zhProse`, which renders the owner's own
 * approved Chinese or, until he has written it, a marked placeholder carrying
 * an English brief — the decision recorded on issue #13. The prose that used
 * to be in this file was an agent's, so it now sits in that file as a draft he
 * can rewrite from, and no sentence of it ships.
 *
 * Same form, same host function, same marked placeholders as the English page.
 * The email address and the booking link are rendered beside their paragraphs
 * rather than inside them, because they are facts from `src/lib/legal.ts`
 * rather than language: an unwritten paragraph must not be able to take the
 * two ways of reaching him off the page with it.
 */
import ContactForm from '../../components/ContactForm.astro';
import Fact from '../../components/Fact.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Fact as LegalFact, isUnknown, operator } from '../../lib/legal';
import { zhProse } from '../../lib/zh-copy';

const email: LegalFact = operator.email;
const booking: LegalFact = operator.bookingUrl;
---

<BaseLayout
  title="聯絡 — 潘威宏博士"
  description="用中文談你的研究資料與統計分析：留訊息、直接寄信，或約一次短通話。三個工作日內回覆。"
>
  <h1>聯絡</h1>

  <p><Fact value={zhProse('write-in-mandarin')} /></p>

  <h2>留訊息給我</h2>

  <ContactForm locale="zh" />

  <h2>多久會收到回覆</h2>

  <p><Fact value={zhProse('reply-time')} /></p>

  <h2>直接寄信給我</h2>

  <p>
    <Fact value={zhProse('email-instead-of-the-form')} />
    {isUnknown(email) ? <Fact value={email} /> : <a href={`mailto:${email}`}>{email}</a>}
  </p>

  <h2>約一次短通話</h2>

  <p>
    <Fact value={zhProse('a-short-call')} />
    {isUnknown(booking) ? <Fact value={booking} /> : <a href={booking}>{booking}</a>}
  </p>
</BaseLayout>
