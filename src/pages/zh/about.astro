---
/**
 * The Traditional Chinese about page.
 *
 * Its prose is not written here. Every paragraph on this page comes from
 * `src/data/zh-copy.yaml` through `zhProse`, which renders the owner's own
 * approved Chinese or, until he has written it, a marked placeholder carrying
 * an English brief. The decision is recorded on issue #13: the Chinese on this
 * site is his, and the prose that used to be in this file was an agent's. So
 * this page holds no Chinese sentence at all, and cannot acquire one.
 *
 * What it does hold is structure, and the two things an unwritten paragraph
 * must not be able to take away with it:
 *
 *   - the link to the PDF CV, labelled with the file name because the document
 *     itself is in English and a file name is not prose to translate;
 *   - the timeline, the publication list and the awards, which are the same
 *     three components the English page uses, reading the same
 *     language-neutral records, so the two pages cannot disagree about what he
 *     has done. The current employer is named inside the timeline, from the
 *     career record — never from a sentence, which is why the intro paragraph
 *     no longer has to carry it.
 *
 * The link into the faith stream went with the faith paragraph, since where it
 * sits in a sentence is part of writing that sentence.
 */
import AwardList from '../../components/AwardList.astro';
import CareerTimeline from '../../components/CareerTimeline.astro';
import Fact from '../../components/Fact.astro';
import PublicationList from '../../components/PublicationList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { unknown } from '../../lib/legal';
import { zhProse } from '../../lib/zh-copy';
---

<BaseLayout
  title="關於潘威宏博士 — 學經歷、期刊論文與獲獎"
  description="自 2012 年起的學經歷年表、完整期刊論文清單、獲獎紀錄，以及兩頁式 PDF 履歷。"
>
  <h1>關於我</h1>

  <p><Fact value={zhProse('bio-since-2012')} /></p>

  <p><Fact value={zhProse('teaching-in-germany')} /></p>

  <figure>
    <Fact
      value={unknown(
        'headshot photograph — a plain professional portrait, with publication consent on file',
      )}
    />
    <figcaption>潘威宏博士</figcaption>
  </figure>

  <p>
    <Fact value={zhProse('cv-download')} />
    <a href="/cv.pdf" download>cv.pdf</a>
  </p>

  <section id="career" aria-labelledby="career-heading">
    <h2 id="career-heading">學經歷年表</h2>
    <CareerTimeline locale="zh" />
  </section>

  <section id="publications" aria-labelledby="publications-heading">
    <h2 id="publications-heading">期刊論文</h2>
    <PublicationList />
  </section>

  <section id="awards" aria-labelledby="awards-heading">
    <h2 id="awards-heading">獲獎紀錄</h2>
    <AwardList locale="zh" />
  </section>

  <section aria-labelledby="faith-heading">
    <h2 id="faith-heading">信仰</h2>
    <p><Fact value={zhProse('faith-and-work')} /></p>
  </section>
</BaseLayout>
